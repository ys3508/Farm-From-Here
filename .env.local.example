# FARM FROM HERE — environment template
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored;
# this template is committed. Restart `npx expo start -c` after changing any value —
# Expo inlines EXPO_PUBLIC_* at bundle time, so a running Metro will not pick them up.
#
# ─────────────────────────────────────────────────────────────────────────────
# HOW THE KEYS SPLIT
#
#   EXPO_PUBLIC_*  → shipped inside the app bundle. Anyone with the app can read
#                    them. ONLY ever put publishable keys here. Never a service-role
#                    key, never an OAuth client SECRET, never the Resend key.
#
#   Everything under "SERVER-SIDE" below is NOT read by this app. Those values are
#   pasted into the Supabase dashboard (Authentication → Providers) or set as Edge
#   Function secrets. They are listed here only so you know the full set you need.
# ─────────────────────────────────────────────────────────────────────────────


# ══ REQUIRED — the app will not start without these ══════════════════════════

# Supabase → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → `anon` / publishable key.
# Safe to ship: it is gated by Row Level Security, which is enabled on every table
# in supabase/migrations/. Do NOT paste the `service_role` key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY


# ══ OPTIONAL — app-side ══════════════════════════════════════════════════════

# Deep-link scheme OAuth redirects come back to. Must match `scheme` in app.json.
# Leave as-is unless you rename the scheme.
EXPO_PUBLIC_APP_SCHEME=farmfromhere

# PREVIEW MODE — walk every screen without signing up.
#
# Fakes a signed-in account with clearly-labelled sample content (balances, two
# PREVIEW farms, a few ledger rows) so screens can be reviewed fully populated.
# A floating PREVIEW pill appears on every screen and opens an index of them all.
#
# Safe to leave on while designing: it is gated on __DEV__ as well as this flag,
# so a production build ignores it entirely and can never ship fake data.
# Restart with `npx expo start -c` after changing it.
EXPO_PUBLIC_PREVIEW_MODE=false


# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE — NOT read by this app. Configure in the Supabase dashboard.
# ─────────────────────────────────────────────────────────────────────────────
#
# For each provider below: Supabase dashboard → Authentication → Providers →
# enable the provider and paste its client ID + secret. Then add this redirect URL
# to the provider's own developer console:
#
#     https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
#
# And in Supabase → Authentication → URL Configuration → Redirect URLs, add BOTH:
#
#     farmfromhere://auth/callback        (device / standalone build)
#     exp://127.0.0.1:8081/--/auth/callback   (Expo Go on a simulator; the real
#         LAN URL is printed by `npx expo start` — add whichever it shows, e.g.
#         exp://192.168.1.20:8081/--/auth/callback)
#
# GOOGLE   — console.cloud.google.com → APIs & Services → Credentials
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#
# FACEBOOK — developers.facebook.com → My Apps → Settings → Basic
#   FACEBOOK_APP_ID=
#   FACEBOOK_APP_SECRET=
#
# TWITTER  — developer.x.com → Projects & Apps → Keys and tokens (OAuth 2.0)
#   TWITTER_CLIENT_ID=
#   TWITTER_CLIENT_SECRET=
#
# APPLE    — developer.apple.com ($99/yr Apple Developer Program).
#   Required by App Store review whenever other third-party logins are offered.
#   Native "Sign in with Apple" on device needs NO key in this file — but Supabase
#   must be told the bundle id, and the web/Android path needs a Services ID:
#   APPLE_SERVICES_ID=com.farmfromhere.app.signin
#   APPLE_TEAM_ID=
#   APPLE_KEY_ID=
#   APPLE_PRIVATE_KEY=            # contents of the .p8 file
#   (Supabase → Providers → Apple → "Authorized Client IDs": com.farmfromhere.app)
#
# PHONE / SMS — NOT WIRED IN V1.0 (SMS costs money per message; see plan.md).
#   The phone screen's UI is built; the backend is a deliberate stub.
#   To turn it on later: Supabase → Providers → Phone, plus a Twilio/MessageBird
#   account, then remove the stub in src/features/auth/AuthProvider.tsx.
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_MESSAGE_SERVICE_SID=
#
# RESEND — the return engine (Step 5). Not sent from the app; a plot update will
#   trigger a Supabase Edge Function that calls Resend server-side.
#   Set with:  supabase secrets set RESEND_API_KEY=re_...
#   RESEND_API_KEY=
#   RESEND_FROM="Farm From Here <hello@your-verified-domain.com>"
